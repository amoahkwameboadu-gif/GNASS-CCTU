{
  "version": 2,
  "buildCommand": "echo 'Static site - no build step' && exit 0",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/admin.html", "destination": "/admin.html" }
  ]
}