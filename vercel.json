{
  "version": 2,
  "outputDirectory": ".",
  "functions": {
    "api/**/*.ts": { "runtime": "@vercel/node@3" },
    "api/**/*.js": { "runtime": "@vercel/node@3" }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/admin.html", "destination": "/admin.html" }
  ]
}